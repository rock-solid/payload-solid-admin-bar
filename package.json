{
  "name": "payload-solid-admin-bar-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter @rocksoliddigital/payload-solid-admin-bar build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm demo:build",
    "demo": "pnpm build && pnpm --filter demo dev",
    "demo:build": "pnpm build && pnpm --filter demo build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "test": "pnpm --filter @rocksoliddigital/payload-solid-admin-bar test",
    "typecheck": "pnpm --filter @rocksoliddigital/payload-solid-admin-bar typecheck && pnpm build && pnpm --filter demo typecheck",
    "version-packages": "changeset version && node scripts/format-changelog.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "lefthook": "^2.1.15",
    "prettier": "^3.6.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.46.0"
  }
}
